# ============================================================
# EchoMind 环境变量配置示例
# 用法: 复制本文件为 .env，放到 backend/ 目录（uvicorn 从该目录启动时自动读取）
#   Windows:     copy .env.example backend\.env
#   macOS/Linux: cp .env.example backend/.env
# 所有项均有默认值，最小改动即可运行: LLM_API_KEY 留空 = mock 模式
# ============================================================

# ---- LLM（OpenAI 兼容协议，换厂商只改这三个值）----
# base_url 示例:
#   DeepSeek: https://api.deepseek.com              （搭配模型 deepseek-chat）
#   智谱 GLM: https://open.bigmodel.cn/api/paas/v4  （搭配模型 glm-4-flash）
LLM_BASE_URL=https://api.deepseek.com
# 留空 = mock 模式: 不调用 LLM，直接回显检索结果，零成本跑通全链路
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Embedding（本地运行，免费；首次启动自动下载模型）----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace 国内镜像，避免直连超时
HF_ENDPOINT=https://hf-mirror.com

# ---- 切块 ----
# 目标块大小（字符）
CHUNK_SIZE=500
# 硬切长段时相邻块的重叠（字符）
CHUNK_OVERLAP=50

# ---- 检索 ----
# 向量召回条数
VECTOR_TOP_K=20
# BM25 召回条数
BM25_TOP_K=20
# RRF 融合后送入大模型 Prompt 的条数
FINAL_TOP_K=5
# RRF 融合常数（论文常用值 60）
RRF_K=60
# 是否启用重排（阶段3开启）
ENABLE_RERANK=false
# 重排模型
RERANK_MODEL=BAAI/bge-reranker-base
# 进入重排的候选条数（默认 10；条数越多 CPU 精排延迟越高）
RERANK_CANDIDATES=10

# ---- 基础设施（默认与 docker-compose.yml 一致）----
# 注意: 后端若也放入容器运行，需把 localhost 换成 compose 服务名 db / redis
DATABASE_URL=postgresql+psycopg://echomind:echomind@localhost:5432/echomind
REDIS_URL=redis://localhost:6379/0

# ---- 缓存与限流（Redis 不可用时自动降级直通，不影响可用性）----
# 检索结果 / 完整回答缓存的 TTL（秒），默认 30 分钟
CACHE_TTL_SECONDS=1800
# 提问接口按 IP 每分钟限流次数（<=0 关闭），默认 10
RATE_LIMIT_PER_MIN=10

# ---- 应用 ----
# 上传文件保存目录（相对后端运行目录）
UPLOAD_DIR=data/uploads
# 单文件大小上限（MB）
MAX_UPLOAD_MB=20
# 跨域白名单（JSON 数组写法）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
